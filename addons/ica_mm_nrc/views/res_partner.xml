<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Inherit Form View to Modify it -->
    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">view_partner_form_inherit_nrc</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('o_address_format')]" position="after">
                <field name="township_id" domain="[('state_id','=',state_id)]"/>
                <field name="nrc_number"/>
                <span string="Full NRC" class="o_form_label">
                    Full NRC
                </span>
                <div class="d-flex">
                    <field name="state_code" class="oe_inline" nolabel="1"/>
                    <field name="township_code" class="oe_inline" nolabel="1"/>
                    <span class="oe_inline" nolabel="1">(နိုင်)</span>
                    <field name="nrc_number" class="oe_inline" nolabel="1" readonly="1"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
