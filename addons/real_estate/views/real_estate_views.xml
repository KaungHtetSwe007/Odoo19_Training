<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="real_estate_view_list" model="ir.ui.view">
        <field name="name">real.estate.view.list</field>
        <field name="model">real.estate</field>
        <field name="arch" type="xml">
            <list string="List Title">
                <field name="title"/>
                <field name="property_type"/>
                <field name="postal_code"/>
                <field name="bedrooms"/>
                <field name="living_areas"/>
                <field name="expected_price"/>
                <field name="best_offer"/>
                <field name="selling_price"/>
            </list>
        </field>
    </record>

    <record id="real_estate_view_form" model="ir.ui.view">
        <field name="name">real.estate.view.form</field>
        <field name="model">real.estate</field>
        <field name="arch" type="xml">
            <form string="Form Title">
                <header>
                    <!-- Buttons and statusbar go here -->
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="title"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="property_type"/>
                            <field name="bedrooms"/>
                            <field name="living_areas"/>
                            <field name="postal_code"/>
                            <field name="available_from"/>
                        </group>
                        <group>
                            <field name="expected_price"/>
                            <field name="best_offer"/>
                            <field name="selling_price"/>
                        </group>
                    </group>
                    <notebook>

                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


    <record id="real_estate_action" model="ir.actions.act_window">
        <field name="name">Real Estate</field>
        <field name="res_model">real.estate</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first record
            </p>
        </field>
    </record>
</odoo>