<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="real_estate_tags_view_list" model="ir.ui.view">
        <field name="name">real.estate.tags.view.list</field>
        <field name="model">real.estate.tags</field>
        <field name="arch" type="xml">
            <list string="List Title">
                <field name="name"/>
                <field name="code"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="real_estate_tags_view_form" model="ir.ui.view">
        <field name="name">real.estate.tags.view.form</field>
        <field name="model">real.estate.tags</field>
        <field name="arch" type="xml">
            <form string="Form Title">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="real_estate_tags_action" model="ir.actions.act_window">
        <field name="name">Real Estate Tags</field>
        <field name="res_model">real.estate.tags</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first record
            </p>
        </field>
    </record>
</odoo>