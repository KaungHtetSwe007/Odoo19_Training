<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="real_estate_offers_view_list" model="ir.ui.view">
        <field name="name">real.estate.offers.view.list</field>
        <field name="model">real.estate.offers</field>
        <field name="arch" type="xml">
            <list string="List Title">
                <field name="name"/>
                <field name="property_id"/>
                <field name="partner_id"/>
                <field name="price"/>
                <field name="validity"/>
                <field name="status"/>
                <field name="currency_id"/>
                <field name="date_deadline"/>
            </list>
        </field>
    </record>

    <record id="real_estate_offers_view_form" model="ir.ui.view">
        <field name="name">real.estate.offers.view.form</field>
        <field name="model">real.estate.offers</field>
        <field name="arch" type="xml">
            <form string="Form Title">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="property_id"/>
                            <field name="price"/>
                            <field name="validity"/>
                            <field name="status"/>
                        </group>
                        <group>
                            <field name="partner_id"/>
                            <field name="currency_id"/>
                            <field name="date_deadline"/>
                            <field name="note"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>


    <record id="real_estate_offers_action" model="ir.actions.act_window">
        <field name="name">Real Estate Offers</field>
        <field name="res_model">real.estate.offers</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
